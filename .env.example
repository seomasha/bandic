# Email delivery for the quote (/dental-tourism) and contact forms.
# Sign up at https://resend.com, create an API key, and set it here
# (and in the Vercel project's Environment Variables) before the
# forms will actually send anything.
RESEND_API_KEY=

# Where enquiries get delivered. Defaults to info@doc-bandic.com if unset.
CONTACT_TO_EMAIL=info@doc-bandic.com

# Sender address Resend sends from. Until a sending domain is verified
# in the Resend dashboard, leave this on the onboarding@resend.dev
# default below — Resend blocks any other "from" address for
# unverified domains. Once doc-bandic.com (or a subdomain) is verified,
# switch this to an address on that domain for better deliverability.
CONTACT_FROM_EMAIL="Poliklinika Bandić Website <onboarding@resend.dev>"

# NOTE: while using the onboarding@resend.dev sender (no verified domain
# yet), Resend's test mode only allows delivery to the email address
# that owns the Resend account — CONTACT_TO_EMAIL will silently fail to
# reach info@doc-bandic.com until a sending domain is verified. Verify
# doc-bandic.com under Resend > Domains before relying on this in
# production; until then, point CONTACT_TO_EMAIL at your own Resend
# signup address for testing.
